{
  "name": "@flowscripter/dynamic-cli-framework",
  "version": "12.0.0",
  "description": "A framework for developing CLI applications which supports dynamic discovery and installation of new commands",
  "keywords": [
    "bun",
    "cli",
    "dynamic",
    "executable",
    "framework",
    "import",
    "plugin"
  ],
  "homepage": "https://github.com/flowscripter/dynamic-cli-framework#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flowscripter/dynamic-cli-framework.git"
  },
  "files": [
    "dist",
    "src",
    "index.ts",
    "cli-plugin.ts",
    "yaml.ts",
    "toml.ts",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli-plugin": {
      "bun": "./cli-plugin.ts",
      "types": "./dist/cli-plugin.d.ts",
      "default": "./dist/cli-plugin.js"
    },
    "./yaml": {
      "bun": "./yaml.ts",
      "types": "./dist/yaml.d.ts",
      "default": "./dist/yaml.js"
    },
    "./toml": {
      "bun": "./toml.ts",
      "types": "./dist/toml.d.ts",
      "default": "./dist/toml.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@flowscripter/dynamic-cli-framework-api": "^5.1.1",
    "@flowscripter/dynamic-plugin-framework": "^2.3.1",
    "emphasize": "^7.0.0",
    "fastest-levenshtein": "^1.0.16",
    "figlet": "^1.12.0",
    "highlight.js": "^11.12.0",
    "prettier": "^3.9.10",
    "semver": "^7.8.5",
    "supports-color": "^11.0.0",
    "supports-terminal-graphics": "^0.1.0"
  },
  "devDependencies": {
    "@decimalturn/toml-patch": "^3.3.1",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "@types/semver": "^7.8.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@decimalturn/toml-patch": "^3.3.1",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  },
  "peerDependenciesMeta": {
    "yaml": {
      "optional": true
    },
    "@decimalturn/toml-patch": {
      "optional": true
    }
  },
  "typedocOptions": {
    "readme": "none",
    "exclude": [
      "tests/**"
    ]
  }
}
