{
  "name": "@flowscripter/dynamic-cli-framework",
  "version": "5.4.0",
  "description": "A framework for developing CLI applications which supports dynamic discovery and installation of new commands",
  "keywords": [
    "bun",
    "cli",
    "dynamic",
    "executable",
    "framework",
    "import",
    "plugin"
  ],
  "homepage": "https://github.com/flowscripter/dynamic-cli-framework#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flowscripter/dynamic-cli-framework.git"
  },
  "files": [
    "dist",
    "src",
    "index.ts",
    "cli-plugin.ts",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli-plugin": {
      "bun": "./cli-plugin.ts",
      "types": "./dist/cli-plugin.d.ts",
      "default": "./dist/cli-plugin.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@flowscripter/dynamic-cli-framework-api": "^2.3.3",
    "@flowscripter/dynamic-plugin-framework": "^2.2.4",
    "emphasize": "^7.0.0",
    "fastest-levenshtein": "^1.0.16",
    "figlet": "^1.11.4",
    "highlight.js": "^11.12.0",
    "prettier": "^3.9.6",
    "semver": "^7.8.5",
    "supports-color": "^11.0.0",
    "supports-terminal-graphics": "^0.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.0",
    "@types/semver": "^7.8.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "typedocOptions": {
    "readme": "none",
    "exclude": [
      "tests/**"
    ]
  }
}
